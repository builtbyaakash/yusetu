# Required once you store upstream secrets (32-byte key, base64-encoded)
# Generate: openssl rand -base64 32
GATEWAY_MASTER_KEY=

# Data directory (SQLite + runtime files)
YUSETU_DATA_DIR=./data

# HTTP listen
HOST=127.0.0.1
PORT=8080

# Public origin for OAuth redirect URIs (outbound upstream OAuth + inbound AS metadata).
# Example: http://127.0.0.1:8080 or https://gateway.example.com
# If unset, derived from each request (X-Forwarded-* or Host).
PUBLIC_ORIGIN=

# Dashboard Vite proxy target
VITE_API_PROXY=http://127.0.0.1:8080

# Require auth on MCP HTTP (/mcp). Default true — clients must use API key or OAuth.
# Set false only for trusted local STDIO bridge experiments.
REQUIRE_MCP_AUTH=true

# Enable built-in OAuth 2.1 (PKCE) for IDE MCP clients (API keys still work)
ENABLE_MCP_OAUTH=true

# Tool catalog presented to agents.
# meta (production default) = five yusetu_* meta tools only
# (yusetu_search_tools, yusetu_list_mcps, yusetu_list_tools, yusetu_get_tool, yusetu_call).
# flat = debug only — exposes every slug__tool (not for production agents).
TOOL_PRESENTATION=meta

# When TOOL_PRESENTATION=meta, optionally inline tiny upstream catalogs as
# slug__tool in tools/list. Default false — agents should use meta tools only.
INLINE_TINY_MCPS=false

# Compress inputSchema returned by yusetu_get_tool (truncate descriptions,
# cap enums, drop $schema). Stored snapshots / yusetu_call still use full schemas.
# Default true.
SCHEMA_COMPRESSION=true

# Git MCP isolation defaults (requires Docker on the gateway host for docker mode).
# docker = slim container + dropped caps (recommended). host = spawn on gateway.
GIT_MCP_DEFAULT_ISOLATION=docker
# DOCKER_BIN=docker
# DOCKER_ISOLATION_NODE_IMAGE=node:22-bookworm-slim
# DOCKER_ISOLATION_UV_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Logging
LOG_LEVEL=info
# none | redacted | full
LOG_TOOL_ARGS=none
